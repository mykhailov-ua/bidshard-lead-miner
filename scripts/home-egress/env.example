# Home egress bridge: Squid on your PC + reverse SSH to parser VPS.
#
# Copy: cp scripts/home-egress/env.example scripts/home-egress/.env.local
#
# Run on HOME machine:
#   make home-egress-proxy-up
#   make home-egress-tunnel
#
# On VPS (.env): PARSER_PROXY_LIST from scripts/home-egress/print-vps-env.sh

# Local Squid (loopback only)
HOME_PROXY_PORT=3128
PROXY_USER=parser
PROXY_PASS=change-me-to-a-long-random-string

# Reverse tunnel: VPS listens here, forwards to home Squid
VPS_TUNNEL_PORT=19888

# VPS SSH (same as config/env/.env.vps-deploy.local)
VPS_SSH_HOST=hostiq
VPS_SSH_USER=root
VPS_SSH_PORT=2222

# Optional: autossh for stable tunnel (install autossh on home)
USE_AUTOSSH=1
