# Squid proxy install env for setup-docker-proxy.sh and install-on-vps.sh.
#
# Usage:
#   cp scripts/vps-proxy/env.example scripts/vps-proxy/.env.local
#   make vps-proxy-docker
#   ./scripts/vps-proxy/print-env-snippet.sh
#
# Requires: change PROXY_PASS before production. Not for Cloudflare igaming crawls.
#
# Squid listen port (default 3128)
PROXY_PORT=3128

# Basic auth credentials - CHANGE before production use
PROXY_USER=parser
PROXY_PASS=change-me-to-a-long-random-string

# Public IP of your VPS (for PARSER_PROXY_LIST snippet). install-on-vps.sh auto-detects if empty.
VPS_PUBLIC_IP=

# Optional: restrict Squid to your home/office IP (iptables/ufw hint only)
# ALLOW_CLIENT_IP=203.0.113.10
