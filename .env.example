# Telegram (Telethon sidecar)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# MongoDB storage
MONGO_URI=mongodb://localhost:27017
MONGO_DB=parser
PARSER_MONGO_COLLECTION=leads

# Optional JSON export (append-only, one object per line)
# PARSER_EXPORT_JSON=data/export/leads.jsonl

# Optional: docker exec if mongodump is only inside container
# MONGO_CONTAINER=bidshard-leads-mongo-1
# Volumes: ./data (sessions, export), ./config (telegram yaml)
# network_mode: host — MONGO_URI=mongodb://localhost:27017 works as on host

# Keywords for scoring (shared with bidshard-leads)
KEYWORDS_JSON_PATH=data/keywords.json
KEYWORDS_GRAY_JSON_PATH=data/keywords-gray.json

# Geo hard-reject (ISO 3166-1 alpha-2, comma-separated)
GEO_BLOCK_COUNTRIES=RU,BY

# Forum / lander seeds
FORUM_SEED_PATH=data/seeds/forum_threads.csv
LANDER_SEED_PATH=data/seeds/lander_urls.csv
# PARSER_LANDER_HEADLESS=false

SUPPLY_SEED_PATH=data/seeds/domains.csv
SUPPLY_HOST_RPS=2
# SUPPLY_BASE_URL=http://127.0.0.1:8080  # test/mock only


PARSER_POLL_SEC=120
PARSER_WORKERS=4
PARSER_TASK_BUFFER=128
PARSER_SOURCE_CONCURRENCY=3
PARSER_SCAN_TIMEOUT=5m
PARSER_HTTP_TIMEOUT=30s
PARSER_SHUTDOWN_TIMEOUT=30s
PARSER_LOG_FORMAT=json
PARSER_LOG_LEVEL=info
PARSER_OUTPUT=table
PARSER_WRITE_SLOTS=8
# PARSER_MX_CHECK=true
