# BidShard Lead Intent Processor - environment template
#
# Usage:
#   cp .env.example .env
#   go run ./cmd/parser config check
#   cat config/env/.env.tgweb.example >> .env    # optional profile (docs/OPS.md)
#
# Load order (internal/config.Load):
#   1. Process environment (docker, shell export) - always wins
#   2. First .env found walking up from cwd (does not override existing vars)
#
# Optional profiles: append config/env/.env.*.example into .env (see docs/OPS.md).
# Prod compliance+CRM: cat config/env/.env.prod.example >> .env
# Max lead-gen coverage: cat config/env/.env.coverage.example >> .env
#
# Background workers (parser run): SERP catalog harvest, Telegram discover, Telegram scrape
# PARSER_SEED_PROFILE=dev   # prod: use data/seeds/*.prod.csv + config/env/.env.vps.example
# PARSER_BG_WORKER=true
# PARSER_BG_TELEGRAM=true  # set false for forum-only discover without Telethon sidecar
# PARSER_BG_SERP_TELEGRAM_MIN=60
# PARSER_BG_TELEGRAM_DISCOVER_MIN=360
# PARSER_BG_TELEGRAM_SCRAPE_MIN=30
# Telegram MTProto user client (Telethon). From my.telegram.org -> API development tools:
# TELEGRAM_API_ID + TELEGRAM_API_HASH (required)
# DC/RSA block on the same page is for Telethon internals - do not paste into .env
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Host Telethon sidecar (after make venv). Docker uses image python.
# PARSER_TELETHON_PYTHON=.venv/bin/python
# TELEGRAM_USE_TEST_DC=true # test DC2 149.154.167.40; default is production
# MTProto proxy for Telethon sidecar (separate from PARSER_PROXY_LIST HTTP crawl):
# TELEGRAM_PROXY_URL=socks5://user:pass@host:1080

# MongoDB storage
MONGO_URI=mongodb://localhost:27017
MONGO_DB=parser
PARSER_MONGO_COLLECTION=leads

# Optional JSON export (append-only; .jsonl = compact lines, .json = pretty blocks)
# PARSER_EXPORT_JSON=data/export/leads.jsonl
# Host runs when .env has Docker /app/... paths:
# PARSER_EXPORT_JSON_HOST=data/export/leads.jsonl
# PARSER_EXPORT_JSON_FORMAT=auto

# Optional CRM webhook (POST LeadDoc JSON on each accepted lead write)
# Point at crm-bot sidecar: POST /v1/leads with same secret as CRM_WEBHOOK_SECRET
# PARSER_CRM_WEBHOOK_URL=http://127.0.0.1:8080/v1/leads
# PARSER_CRM_WEBHOOK_SECRET=
# PARSER_CRM_WEBHOOK=true
# PARSER_CRM_WEBHOOK_AFTER_ANALYSIS=true
# PARSER_CRM_WEBHOOK_HEAT_MIN=warm
# PARSER_CRM_WEBHOOK_HEAT_MIN=hot
# Parser must set PARSER_LEAD_STATUS_ENABLED=true so CRM inbox sees status=new leads

# CRM sidecar (cmd/crm-bot) - HTTP + CLI, no Telegram, no web UI
# Server on VPS: bind localhost; Caddy TLS + basicauth (config/caddy/Caddyfile.example)
# CRM_WEBHOOK_ADDR=127.0.0.1:8080
# CRM_WEBHOOK_SECRET=
# Remote CLI (laptop -> VPS):
# CRM_API_URL=https://crm.example.com
# CRM_API_USER=sales
# CRM_API_PASSWORD=
# CRM_API_TIMEOUT=15s
# On-server Mongo CLI: crm-bot db stats | purge | set-status
# Remote HTTP CLI: crm-bot api list --status new
# Caddy dev edge: make crm-caddy-up
# CRM_SHUTDOWN_TIMEOUT=30s
# CRM_QUERY_TIMEOUT=5s
# CRM_WRITE_TIMEOUT=3s
# CRM_STATS_TIMEOUT=15s
# CRM_METRICS_ADDR=:9465
# CRM_EXPORT_MAX_ROWS=500
# CRM_SEARCH_TIMEOUT=5s
# CRM_SEARCH_MAX_ROWS=20
# CRM_LEAD_NOTES_COLLECTION=lead_notes
# CRM_META_COLLECTION=lead_crm_meta
# CRM_PPROF_ADDR=127.0.0.1:6060
# CRM_LOG_FORMAT=auto
# CRM_LOG_LEVEL=info

# Optional: docker exec if mongodump is only inside container
# MONGO_CONTAINER=bidshard-leads-mongo-1
# Volumes: ./data (sessions, export), ./config (telegram yaml)
# network_mode: host - MONGO_URI=mongodb://localhost:27017 works as on host

# PARSER_SOURCE=forum|supply|lander|reddit|discord|warrior|ct|github|reviews|all
# PARSER_SOURCE=all runs forum+supply+reddit+discord+serp (lander opt-in; not in all)
# If forum is disabled, keep reddit in PARSER_SOURCE for direct-egress public coverage.
# Accept-quality Tier 0: cat config/env/.env.precision.example >> .env
# Global HTTP bundle: forum,supply,reddit,serp,reviews - see config/env/.env.global.example
# warriorforum.com: merged into forum via WARRIOR_SEED_PATH (no separate warrior source)
# REDDIT_SUBREDDITS=affiliatemarketing,media_buying,adops,PPC,juststart
# REDDIT_QUERIES=voluum alternative;tracker too expensive;postback failing;click id not found;self-hosted tracker;tracker migration
# REDDIT_MAX_RESULTS=25

# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# New API keys: gemini-2.5-flash returns NOT_FOUND; see https://ai.google.dev/gemini-api/docs/models
# Cheaper high-volume: gemini-3.5-flash-lite or gemini-3.1-flash-lite
# Override if your tier differs: https://ai.google.dev/gemini-api/docs/rate-limits
# GEMINI_RPM=15
# GEMINI_TPM=1000000
# GEMINI_RPD=1500
# GEMINI_EMBED_RPM=5
# GEMINI_MAX_RETRIES=4
# GEMINI_REQUEST_TIMEOUT=60s
# GEMINI_ANALYZE_INTERVAL=15m
# GEMINI_REPORT_INTERVAL=6h
# GEMINI_BATCH_SIZE=20
# PARSER_HARD_REJECT_SHADOW_PCT=2
# PARSER_HARD_REJECT_SHADOW_DAILY_CAP=10
# PARSER_STALE_LEAD_REGRADE_INTERVAL=168h
# PARSER_STALE_LEAD_AGE=720h
# PARSER_DUPLICATE_SUGGEST_INTERVAL=24h
# PARSER_DUPLICATE_SUGGEST_WINDOW=168h
# GEMINI_LEAD_ANALYZE_INTERVAL=5m
# GEMINI_LEAD_BATCH_SIZE=15
# GEMINI_QUOTA_CRITICAL_PCT=20
# GEMINI_QUOTA_HIGH_PCT=40
# GEMINI_QUOTA_NORMAL_PCT=25
# GEMINI_QUOTA_LOW_PCT=15
# WARM_LEAD_QUEUE_SIZE=256
# WARM_ANALYSIS_RETRY_MAX=3
# WARM_ANALYSIS_RETRY_BASE=5s
# WARM_ANALYSIS_PENDING_SCAN_INTERVAL=5m
# WARM_ANALYSIS_PENDING_STALE=1h
# WARM_ANALYSIS_DLQ_COLLECTION=warm_analysis_dlq
# WARM_ANALYSIS_SHUTDOWN_DRAIN=2m
#
# Pre-deploy BPF leak gate (Linux + sudo): make tgweb-bpf-leak-gate or make deploy-preflight
# PARSER_BPF_PREFLIGHT=1          # run BPF leak probe in make deploy-preflight (default 1 on VPS profile)
# TGWEB_BPF_LEAK_DOMAINS=blask.com   # default crawl scope for leak probe
# PARSER_BPF_LEAK_GATE_STRICT=1      # exit non-zero when leak-gate fails (set by preflight script)
# PARSER_BPF_SUDO_PASS=               # optional non-interactive sudo for bpf-collector
# PARSER_BPF_METRICS_ADDR=:9464
#
# Geo compliance (prod with CRM webhook): inline Gemini geo before Mongo write.
# PARSER_GEMINI_DEFER=true  # defer ICP/engage to warm-path; tgweb sync ICP still runs when PARSER_ICP_CLASSIFY_TGWEB=true
# PARSER_GEMINI_SYNC_GEO=true  # REQUIRED with defer+CRM: run geo classify on hot path before upsert/webhook
# PARSER_GEO_CLASSIFY=true  # requires GEMINI_API_KEY; blocks RU/BY via Gemini before accept when sync geo on
# GEMINI_EMBED_THRESHOLD=0.92
# Embedding model: gemini-embedding-001 (768 dims)
# GEMINI_KEYWORD_DIFF_EVERY=5
# GEMINI_KEYWORD_DIFF_DIR=data/suggestions
# GEMINI_PAIN_VOCAB_DIFF_EVERY=5
# PARSER_ENTITY_OUTREACH_NARRATIVE=false  # Gemini entity classify + outreach_angle; sales: crm-bot entity inbox
# PARSER_WARM_EMBED_PRESCAN=true  # default on with defer+CRM: embed spam gate before warm Gemini
# PARSER_WARM_EMBED_CLUSTER=true  # default on with defer+CRM: semantic dedup before warm Gemini
# PARSER_GEMINI_ENGAGE_MEDIUM=false
# PARSER_ENTITY_LINK_SUGGEST=false  # forum_user/telegram/email link review; crm-bot entity suggestions
# GEMINI_DISCOVER_DIFF_EVERY=5
# GEMINI_DISCOVER_DIFF_DIR=data/suggestions
# PARSER_DISCOVER_AUTO_APPLY_MAX_WEEK=30
# PARSER_GEMINI_ENRICH_SYNTH=false  # High-priority leads only when enabled
# TELEGRAM_PREFILTER=true
# TELEGRAM_GEO_HEURISTIC=true  # skip RU/BY-looking Telegram channels at discover/scrape
# PARSER_ICP_CLASSIFY=true
# PARSER_ICP_CLASSIFY_TGWEB=true  # Sync ICP gate for tgweb (runs even with PARSER_GEMINI_DEFER; needs GEMINI_API_KEY)
# PARSER_INTENT_CLASSIFY=false  # Tier 3: buyer_search gate on github/lander/TG channel (auto true with CRM+defer)
# PARSER_INTENT_MIN_CONFIDENCE=0.8  # Drop when intent != buyer_search or confidence below threshold
# PARSER_SOURCE_PRIORITY=true  # Tier 3: collect reddit/forum before lander/github each scan round
# PARSER_LANDER_OUTREACH=false  # Tier 3: lander crawl is intel-only (supply registry); set true for CRM leads
# PARSER_GITHUB_ENABLED=false  # opt-in: set true to enable github in PARSER_SOURCE (prod config check)
# PARSER_TGWEB_PRESCAN_MODE=aggressive  # aggressive: site LPR passes prescan; strict: require affiliate keywords (prod: strict)
# PARSER_GEO_CLASSIFY=true  # prod: enable with GEMINI_API_KEY and PARSER_GEMINI_SYNC_GEO=true when CRM webhook on
# PARSER_GEMINI_ENGAGE=false  # High-priority leads only when enabled
# PARSER_EMBED_PRESCAN=false  # prod CRM+defer: auto true via applyAcceptQualityDefaults; TG spam on hot path
# PARSER_EMBED_CLUSTER=false  # High-priority leads only when enabled
# GEMINI_EMBED_PAIN_MIN=0.78
# GEMINI_EMBED_SPAM_MIN=0.82
# PARSER_TIME_DECAY=true  # fresh pain +10 (48h), recent +5 (7d), aged -5 (180d), stale -10
# PARSER_ENRICH_RDAP=true
# PARSER_ENRICH_DNS=true
# PARSER_ENRICH_EMAIL=true
# PARSER_ENRICH_SMTP_VERIFY=false  # opt-in; SMTP port 25 often blocked on residential egress
# PARSER_PROFILE_ENRICH=true
# DISCORD_BOT_TOKEN=
# DISCORD_CHANNEL_IDS=1234567890,9876543210
# DISCORD_MAX_MESSAGES=50

# GITHUB_TOKEN=
# GITHUB_SEARCH_QUERIES=voluum alternative;self-hosted tracker;keitaro docker

# CT_QUERIES=track,click,go
# CT_MAX_RESULTS=100

# COLD_JUNK_QUEUE_SIZE=512
# COLD_JUNK_COLLECTION=junk_leads
# COLD_REPORT_COLLECTION=junk_reports

KEYWORDS_JSON_PATH=data/keywords.json
KEYWORDS_GRAY_JSON_PATH=data/keywords-gray.json
DISPOSABLE_DOMAINS_PATH=data/disposable_domains.txt
BLACKLIST_DOMAINS_PATH=data/blacklist_domains.txt
BLACKLIST_EMAILS_PATH=data/blacklist_emails.txt

# Lead status & CRM handoff
# PARSER_LEAD_STATUS_ENABLED=false
# PARSER_PILOT_TAG=true
# KEYWORDS_LOCALE=es,pt  # comma-separated -> data/keywords-{locale}.json overlays (LATAM/EU bias)
# KEYWORDS_LOCALE_PATH=  # optional single overlay file override
# KEYWORD_STATS_COLLECTION=keyword_stats
# PARSER_ENTITY_SIGHTINGS=true
# ENTITY_COLLECTION=entities
# PARSER_CROSS_SOURCE_HOT=true
# PARSER_CROSS_SOURCE_HOT_WINDOW=168h
# PARSER_CROSS_SOURCE_HOT_BOOST=20
# PARSER_ENTITY_HEAT_ENABLED=true
# PARSER_ENTITY_HEAT_BLAZING=80
# PARSER_ENTITY_HEAT_HOT=50
# PARSER_ENTITY_HEAT_WARM=25
# PARSER_ENTITY_HEAT_DECAY_7D=1.0
# PARSER_ENTITY_HEAT_DECAY_30D=0.6
# PARSER_ENTITY_HEAT_DECAY_90D=0.25
# PARSER_ENTITY_GEMINI_ENABLED=true
# PARSER_ENTITY_GEMINI_DEBOUNCE=6h
# PARSER_ENTITY_GEMINI_LOW_CONF_DEBOUNCE=1h
# PARSER_GEO_AUDIT_INTERVAL=168h
# PARSER_GEO_AUDIT_SAMPLE_N=10
# PARSER_GEO_AUDIT_COLLECTION=geo_audit_reports
# PARSER_WEBHOOK_AUDIT_INTERVAL=720h
# PARSER_WEBHOOK_FEEDBACK_COLLECTION=webhook_feedback
# PARSER_CHANNEL_TRIAGE=false  # prod+telegram: auto true; Gemini drops news/recruit channels from registry
# PARSER_BG_CHANNEL_TRIAGE_INTERVAL=6h
# PARSER_DOMAIN_TRIAGE=false
# PARSER_LANDER_PATH_DISCOVER=true
# PARSER_LANDER_PATH_GEMINI=false
# LANDER_PATHS_CACHE_PATH=data/runtime/lander_paths.json
# PARSER_BG_DOMAIN_TRIAGE_INTERVAL=6h
# DOMAIN_TRIAGE_CACHE_PATH=data/runtime/domain_triage_cache.json
# TELEGRAM_CHANNELS_PATH=data/runtime/discovered_telegram_channels.json
# TELEGRAM_CURSOR_DB_PATH=data/runtime/crawler.db
# TELEGRAM_CHANNEL_SEARCH_LIMIT=3  # max in-channel search queries per channel per day
# TELEGRAM_DISCUSSION_SCRAPE=0  # scrape linked discussion groups (default off)
# TELEGRAM_GLOBAL_SEARCH=0  # optional SearchGlobal pain queries during scrape
# TELEGRAM_GLOBAL_SEARCH_LIMIT=5  # max global search queries per UTC hour
# TELEGRAM_INVITE_JOIN=0  # allow ImportChatInvite on scrape when chat_id unknown
# TELEGRAM_INVITE_JOIN_LIMIT=3  # max invite joins per day when TELEGRAM_INVITE_JOIN=1
# TELEGRAM_REALTIME=0  # long-running NewMessage listener (parser telegram realtime)
# PARSER_ENTITY_GEMINI_INTERVAL=5m
# PARSER_ENTITY_GEMINI_QUEUE_SIZE=128

# Warrior forum seeds (merged into forum crawl; legacy WARRIOR_SEED_PATH alias)
WARRIOR_SEED_PATH=data/seeds/warrior_threads.csv
# WARRIOR_HOST_RPS=1

# Geo hard-reject (ISO 3166-1 alpha-2, comma-separated)
GEO_BLOCK_COUNTRIES=RU,BY

# Forum / lander seeds
FORUM_SEED_PATH=data/seeds/forum_threads.csv
# Extra forum hosts for SERP harvest + registry (merged with built-in defaults)
# FORUM_HOST_ALLOWLIST=cpamafia.co,example-forum.com
# FORUM_HOST_ALLOWLIST_PATH=data/seeds/forum_hosts.txt
# FORUM_REGISTRY_PATH=data/runtime/discovered_forum_threads.json
# WEB_PAIN_REGISTRY_PATH=data/runtime/discovered_web_pain.json
# SOURCE_REGISTRY_PATH=data/runtime/source_registry.json
# PARSER_AUTO_DISCOVER=false
# PARSER_SEED_FEEDBACK=false
# PARSER_SEED_FEEDBACK_MIN_HEAT=hot
# PARSER_BG_FORUM_DISCOVER_INTERVAL=12h
# PARSER_BG_SOURCE_REGISTRY_SYNC_MIN=30
# PARSER_BG_AUTO_REPORT_INTERVAL=168h
# PARSER_AUTO_REPORT_PATH=data/runtime/auto_report.jsonl
# PARSER_BG_DISCORD_DISCOVER_INTERVAL=24h
# DISCORD_REGISTRY_PATH=data/runtime/discovered_discord_invites.json
# PARSER_SOURCE_DISABLE_GOVERNOR=false  # prod CRM: auto true; disables families with raw>=min and zero accepts
# CRM_ENGAGE_PRIORITY_MIN=70  # sales inbox floor; crm-bot list/entity inbox default sort engage_priority
# PARSER_DISABLED_SOURCES_PATH=data/runtime/disabled_sources.json
# PARSER_SOURCE_DISABLE_MIN_RAW=100
# PARSER_BG_SOURCE_DISABLE_INTERVAL=24h
# PARSER_DISCOVER_FEEDBACK=false
# PARSER_DISABLED_DORKS_PATH=data/runtime/disabled_dorks.json
# PARSER_DORK_DISABLE_MIN_RAW=30
# PARSER_DORK_DISABLE_MAX_ACCEPT_RATE=0.05
# PARSER_BG_DISCOVER_FEEDBACK_INTERVAL=24h
# PARSER_KEYWORD_TUNE_AUTO_APPLY=false
# PARSER_KEYWORD_TUNE_AUTO_APPLY_MAX_WEEK=15
# PARSER_SALES_EXPORT_RU=false
# PARSER_SALES_EXPORT_DIR=data/export/sales
# PARSER_GITHUB_ROTATE=false
# GITHUB_ROTATE_STATE_PATH=data/runtime/github_query_rotate.json
LANDER_SEED_PATH=data/seeds/lander_urls.csv
# PARSER_LANDER_HEADLESS=false  # Playwright fallback for lander/tgweb (needs browser process)
# PARSER_LANDER_HEADLESS_DEFER=true  # queue static failures; drain nightly via headless drain
# PARSER_LANDER_HEADLESS_QUEUE_PATH=data/runtime/headless_queue.json
# PARSER_LANDER_HEADLESS_DRAIN_LIMIT=25
# PARSER_LANDER_HEADLESS_MAX_BROWSERS=2
SUPPLY_HOST_RPS=2
# SUPPLY_BASE_URL=http://127.0.0.1:8080  # test/mock only

# Telegram web crawl (affiliate sites from discovered_telegram_domains.json)
# TELEGRAM_WEB_MAX_DOMAINS=100
# TELEGRAM_WEB_RESCAN_DAYS=30
# TELEGRAM_WEB_DOMAINS=buylink.pro,topxpartners.com  # optional allowlist for targeted crawl
# TELEGRAM_DOMAINS_PATH=data/runtime/discovered_telegram_domains.json

# Proxy rotation for tgweb / forum / serp (uTLS + Cloudflare cooldown)
# Empty PARSER_PROXY_LIST = direct egress (prefer on home IP for Cloudflare targets).
# Residential: docs/OPS.md#proxy, config/env/.env.residential.example
# Datacenter VPS Squid (not for CF igaming): docs/OPS.md#vps-squid-optional
# Preflight: make preflight-tgweb Proxy test: make proxy-check
#
# Do not set placeholder URLs - crawl hard-fails on first fetch.
# PARSER_PROXY_LIST=
# Residential (see docs/DEPLOY.md#recommended-stack-no-passport):
# PARSER_PROXY_LIST=http://YOUR_USER:YOUR_PASS@gw.dataimpulse.com:823
# PARSER_PROXY_LIST=http://YOUR_USER:YOUR_PASS@connect.proxies.vision:8080
# PARSER_PROXY_LIST=http://YOUR_USER:YOUR_PASS@geo.iproyal.com:12321
# VPS Squid:
# PARSER_PROXY_LIST=http://parser:YOUR_PASS@YOUR_VPS_IP:3128
# Comma-separate multiple URLs for round-robin + per-URL block cooldown.
# PARSER_PROXY_LIST=http://user:pass@proxy1:3128,http://user:pass@proxy2:3128
#
# Per-proxy rate limit and cooldown (prod: keep defaults unless provider asks otherwise).
# PARSER_PROXY_RPS=0.5
# PARSER_PROXY_BURST=1
# PARSER_PROXY_COOLDOWN=10m
#
# Per-source proxy routing (budget profile: reddit/discord direct, CF sources via proxy).
# Unset PARSER_PROXY_SOURCES + PARSER_PROXY_LIST set defaults to forum,tgweb,lander,webpain (serp/reddit/github direct).
# Empty PARSER_PROXY_LIST: SERP bg harvest uses direct egress; add serp to PARSER_PROXY_SOURCES to require proxy.
# PARSER_PROXY_SOURCES=forum,tgweb,lander
# PARSER_PROXY_DAILY_MB_CAP=350
# PARSER_PROXY_BUDGET_STATE_PATH=data/runtime/proxy_budget.json


PARSER_POLL_SEC=120
PARSER_WORKERS=4
PARSER_TASK_BUFFER=128
PARSER_SOURCE_CONCURRENCY=3
# Per-lead pipeline timeout (Gemini/MX/Mongo); collect_once also uses PARSER_SCAN_TIMEOUT
# PARSER_TASK_TIMEOUT=90s
PARSER_SCAN_TIMEOUT=5m
PARSER_HTTP_TIMEOUT=30s
PARSER_SHUTDOWN_TIMEOUT=120s
# Pipeline drain for collect_once / telegram web (no worker cancel on slow drain)
# PARSER_COLLECT_DRAIN_TIMEOUT=120s
PARSER_LOG_FORMAT=auto
PARSER_LOG_LEVEL=info
PARSER_OUTPUT=auto
PARSER_WRITE_SLOTS=8
PARSER_MX_CHECK=true
# PARSER_MX_CHECK=false  # local dev: skip DNS MX gate on email leads
