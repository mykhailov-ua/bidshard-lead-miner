# Fully automated v1 profile - merge after .env.example
#
# Usage:
#   cp .env.example .env
#   cat config/env/.env.auto.example >> .env
#   cat config/env/.env.residential.example >> .env   # set PARSER_PROXY_LIST
#   # set GEMINI_API_KEY, TELEGRAM_API_*
#   go run ./cmd/parser config check
#
# Outcome: SERP/TG discover, channel triage, defer analysis, CRM after analysis,
# proxy only on CF-heavy sources (forum/tgweb/lander). No manual chats[] or Discord IDs.
#
# Docs: docs/DEPLOY.md

PARSER_SEED_PROFILE=prod
PARSER_SOURCE=reddit,serp
PARSER_BG_TELEGRAM=1
PARSER_CHANNEL_TRIAGE=true
PARSER_DOMAIN_TRIAGE=true
PARSER_GEMINI_DEFER=true
PARSER_CRM_WEBHOOK_AFTER_ANALYSIS=true
PARSER_PROXY_SOURCES=forum,tgweb,lander

PARSER_POLL_SEC=120
PARSER_METRICS_ADDR=:9465

PARSER_GEO_CLASSIFY=true
PARSER_ICP_CLASSIFY=true
PARSER_LEAD_STATUS_ENABLED=true
# GEMINI_API_KEY=...

MONGO_URI=mongodb://127.0.0.1:27017
PARSER_EXPORT_JSON_HOST=data/export/leads.jsonl

TELEGRAM_DOMAINS_PATH=data/runtime/discovered_telegram_domains.json
TELEGRAM_CHANNELS_PATH=data/runtime/discovered_telegram_channels.json
FORUM_REGISTRY_PATH=data/runtime/discovered_forum_threads.json
SOURCE_REGISTRY_PATH=data/runtime/source_registry.json
PARSER_AUTO_DISCOVER=true
# PARSER_SEED_FEEDBACK=true
PARSER_ENTITY_OUTREACH_NARRATIVE=true

# Residential proxy required for forum/tgweb on datacenter VPS:
# PARSER_PROXY_LIST=http://user-country-de-session-auto:PASS@gw.dataimpulse.com:823
