# Global discovery profile - merge after .env.example (optional)
#
# Usage:
#   cat config/env/.env.global.example >> .env
#
# Boosts non-RU recall: locale keyword overlays, broader HTTP sources, discover suggestions.

# Comma-separated overlays: data/keywords-{locale}.json (es, pt, de, fr, pl)
KEYWORDS_LOCALE=es,pt

# HTTP sources (telegram/tgweb need separate Telethon sidecar + tgweb profile)
# lander/github opt-in only (see config/env/.env.precision.example)
PARSER_SOURCE=forum,supply,reddit,serp,reviews

# Reddit (EN global buyer surface)
REDDIT_SUBREDDITS=affiliatemarketing,media_buying,adops,PPC,juststart
REDDIT_QUERIES=voluum alternative;tracker too expensive;postback failing;click id not found;self-hosted tracker;tracker migration

# GitHub issue search (discovery only; do not add github to PARSER_SOURCE without pain gate)
# GITHUB_TOKEN=
GITHUB_SEARCH_QUERIES=voluum alternative;self-hosted tracker;keitaro docker;postback failing

# Gemini discover diff: suggestions under data/suggestions/ (manual merge to discover.icp.json)
GEMINI_DISCOVER_DIFF_EVERY=5
GEMINI_DISCOVER_DIFF_DIR=data/suggestions

# Discord (optional)
# DISCORD_BOT_TOKEN=
# DISCORD_CHANNEL_IDS=
