# Local dev profile (direct egress, no proxy) - merge into .env
#
# Usage:
#   cp .env.example .env
#   cat config/env/.env.local.example >> .env
#   TGWEB_CRAWL_MODE=host make tgweb-crawl
#
# Best for: home IP + Cloudflare targets. Leave PARSER_PROXY_LIST empty.

MONGO_URI=mongodb://localhost:27017
MONGO_DB=parser

# Leave empty or omit - parser uses direct HTTP (uTLS Chrome fingerprint).
# PARSER_PROXY_LIST=

PARSER_TGWEB_PRESCAN_MODE=aggressive
PARSER_ICP_CLASSIFY_TGWEB=true
PARSER_GEMINI_DEFER=true

TELEGRAM_DOMAINS_PATH=data/runtime/discovered_telegram_domains.json
# TELEGRAM_WEB_MAX_DOMAINS=25
# TELEGRAM_WEB_DOMAINS=buylink.pro,topxpartners.com

PARSER_LANDER_HEADLESS=false
PARSER_HTTP_TIMEOUT=30s
PARSER_SCAN_TIMEOUT=5m
# PARSER_MX_CHECK=false  # optional: skip MX gate when testing without DNS
