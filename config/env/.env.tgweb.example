# tgweb crawl profile - merge into .env after .env.example
#
# Usage:
#   cp .env.example .env
#   cat config/env/.env.tgweb.example >> .env
#   make preflight-tgweb && make tgweb-crawl
#
# Requires: GEMINI_API_KEY, non-empty discovered_telegram_domains.json (make tgweb-seed or tgweb-discover).
# Note: PARSER_ICP_CLASSIFY_TGWEB runs sync ICP even when PARSER_GEMINI_DEFER=true.

MONGO_URI=mongodb://localhost:27017
MONGO_DB=parser
PARSER_MONGO_COLLECTION=leads

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

PARSER_TGWEB_PRESCAN_MODE=aggressive
PARSER_ICP_CLASSIFY_TGWEB=true
PARSER_GEMINI_DEFER=true

TELEGRAM_DOMAINS_PATH=data/runtime/discovered_telegram_domains.json
TELEGRAM_WEB_MAX_DOMAINS=100
TELEGRAM_WEB_RESCAN_DAYS=30

# Optional targeted crawl (must exist in discovered_telegram_domains.json; ignores crawled_at):
# TELEGRAM_WEB_DOMAINS=buylink.pro,topxpartners.com

# Proxy: empty = direct. Use residential profile when parser runs on datacenter egress.
# PARSER_PROXY_LIST=

PARSER_WORKERS=4
PARSER_TASK_BUFFER=128
PARSER_SCAN_TIMEOUT=5m
PARSER_COLLECT_DRAIN_TIMEOUT=120s
PARSER_HTTP_TIMEOUT=30s

PARSER_EXPORT_JSON=data/export/leads.jsonl
