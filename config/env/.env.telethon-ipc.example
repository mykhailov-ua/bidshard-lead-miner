# Telethon sidecar IPC profile - Unix domain socket + MessagePack frames.
#
# Usage:
#   cat config/env/.env.telethon-ipc.example >> .env
#   make venv   # installs msgpack
#
# Go listens on the socket; Python connects as client. Bypasses JSON encode/decode
# and avoids TCP loopback. Default without this file: io.Pipe + NDJSON stdout.

TELETHON_IPC_SOCKET=data/runtime/telethon.sock
TELETHON_IPC_FORMAT=msgpack
