# Buyer discovery profile: parallel sources + residential proxy on poll loop.
#
# Usage:
#   cp .env.example .env
#   cat config/env/.env.buyer-zero.example >> .env
#   # PARSER_PROXY_LIST in config/env/.env.proxy.local
#   parser run
#
# Heavier mix (supply/lander/github): cat config/env/.env.proxy-heavy.example >> .env
#
# Optional cron SERP harvest only:
#   0 6,18 * * * cd /path/lead-intent-processor && bash scripts/ops/buyer-discover.sh >> var/buyer-discover.log 2>&1

PARSER_SEED_PROFILE=prod

# Buyer-intent mix; each source Collect runs in parallel (PARSER_SOURCE_CONCURRENCY=0).
PARSER_SOURCE=forum,webpain,reddit,serp,reviews,tgweb,github
PARSER_GITHUB_ENABLED=true

PARSER_SOURCE_CONCURRENCY=0
PARSER_WORKERS=8
PARSER_HTTP_WORKERS=20
PARSER_TASK_BUFFER=256
PARSER_SCAN_TIMEOUT=12m

PARSER_PROXY_SOURCES=forum,tgweb,webpain,serp,reviews
PARSER_PROXY_DAILY_MB_CAP=0
PARSER_BG_TELEGRAM_WEB_MIN=0

# Background SERP harvest + Telegram scrape (parser run).
PARSER_BG_WORKER=true
PARSER_BG_TELEGRAM=true
PARSER_CHANNEL_TRIAGE=true
PARSER_BG_SERP_TELEGRAM_MIN=360
PARSER_BG_TELEGRAM_DISCOVER_MIN=720
PARSER_BG_TELEGRAM_SCRAPE_MIN=30

TELEGRAM_CHANNELS_PATH=data/runtime/discovered_telegram_channels.json
TELEGRAM_PREFILTER=true
TELEGRAM_GEO_HEURISTIC=true

# Reddit: direct egress, no proxy.
REDDIT_SUBREDDITS=affiliatemarketing,media_buying,adops,PPC,juststart
REDDIT_QUERIES=voluum alternative;tracker too expensive;postback failing;click id not found;self-hosted tracker;tracker migration;media buying team;pay usdt tracker;keitaro too expensive
REDDIT_MAX_RESULTS=50

# Warm path + CRM (requires GEMINI_API_KEY already on account).
PARSER_GEMINI_DEFER=true
PARSER_ICP_CLASSIFY=true
PARSER_INTENT_CLASSIFY=true
PARSER_ENTITY_HEAT_ENABLED=true
CRM_ENGAGE_PRIORITY_MIN=70

PARSER_POLL_SEC=300
