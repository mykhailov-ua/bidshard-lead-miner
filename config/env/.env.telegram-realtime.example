# Telegram realtime primary funnel (M2) + pain AND-gate (M3).
#
# Usage:
#   cat config/env/.env.telegram-realtime.example >> .env
#   docker compose -f docker-compose.telegram-realtime.yaml --profile parser-telegram-realtime up -d
#
# Requires TELEGRAM_ALERT_* for pain cards and GEMINI off on free tier.

TELEGRAM_REALTIME=1
TELEGRAM_REALTIME_BACKFILL=200
TELEGRAM_REALTIME_ROLE_FILTER=buyer_supergroup
TELEGRAM_ALERT_ENABLED=1

# UDS + MessagePack IPC (same container as parser telegram realtime)
TELETHON_IPC_SOCKET=data/runtime/telethon.sock
TELETHON_IPC_FORMAT=msgpack
