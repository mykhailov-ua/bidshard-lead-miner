# Gemini Batch API profile - async warm-path ICP/geo at 50% token cost.
#
# Usage:
#   cat config/env/.env.gemini-batch.example >> .env
#
# Strategy:
#   - GEMINI_BATCH_MODE=true: warm path spills to JSONL, flushes to batches.create
#   - Bypasses sync generateContent RPM; turnaround usually minutes-hours (not realtime)
#   - Two-phase: core batch (ICP/geo/pilot) then engage batch for High-only leads
#   - Pack 20-50 leads per request via GEMINI_LEAD_BATCH_SIZE (one generateContent per chunk)
#
# Re-enable on VPS only after GEMINI_API_KEY is set and free-tier sync RPM is exhausted.

GEMINI_BATCH_MODE=true
GEMINI_BATCH_FLUSH_INTERVAL=30m
GEMINI_BATCH_POLL_INTERVAL=2m
GEMINI_BATCH_SPILL_PATH=data/runtime/gemini_batch_spill.jsonl
GEMINI_BATCH_ENGAGE_SPILL_PATH=data/runtime/gemini_batch_engage_spill.jsonl
GEMINI_BATCH_STATE_PATH=data/runtime/gemini_batch_jobs.json

PARSER_GEMINI_DEFER=true
PARSER_ICP_CLASSIFY=true
PARSER_GEO_CLASSIFY=true
PARSER_GEMINI_SYNC_GEO=false
PARSER_INTENT_CLASSIFY=false
PARSER_GEMINI_ENGAGE=true
PARSER_GEMINI_ENRICH_SYNTH=true
PARSER_WARM_EMBED_PRESCAN=false
PARSER_CHANNEL_TRIAGE=false
PARSER_ENTITY_GEMINI_ENABLED=false
GEMINI_JUNK_ANALYZE=false

GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_LEAD_ANALYZE_INTERVAL=5m
GEMINI_LEAD_BATCH_SIZE=32
GEMINI_LEAD_ENGAGE_BATCH_SIZE=8
