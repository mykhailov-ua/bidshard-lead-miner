# VPS deploy CLI (lip) and GitHub Actions auto-deploy.
# Copy to config/env/.env.vps-deploy.local (gitignored).
#
# Local laptop (uses ~/.ssh/config alias hostiq):
VPS_SSH_HOST=hostiq
VPS_SSH_USER=root
VPS_SSH_PORT=22
VPS_REMOTE_DIR=/opt/lead-intent-processor
#
# GitHub repository secrets (Settings -> Secrets and variables -> Actions):
#   VPS_SSH_HOST=45.94.158.106
#   VPS_SSH_USER=root
#   VPS_SSH_PORT=22
#   VPS_SSH_PRIVATE_KEY=<contents of ~/.ssh/hostiq-kvps private key>
#   VPS_REMOTE_DIR=/opt/lead-intent-processor
#
# Push to main runs deploy after CI tests pass (see .github/workflows/deploy.yml).
