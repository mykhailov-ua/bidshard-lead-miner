# Accept-quality Tier 0 - merge after .env.example (+ .env.prod.example for CRM)
#
# Goal: fewer junk accepts, more buyer-intent leads without Tier1 code gates.
# Requires GEMINI_API_KEY and warm path running (parser run + PARSER_GEMINI_DEFER).
#
# Usage:
#   cat config/env/.env.precision.example >> .env

# Buyer-intent HTTP mix (no lander/github in default crawl)
PARSER_SOURCE=forum,supply,reddit,serp,reviews,tgweb

# Hot-path Gemini gates (also auto-enabled by applyAcceptQualityDefaults when CRM+defer+key)
PARSER_ICP_CLASSIFY=true
PARSER_EMBED_PRESCAN=true
PARSER_ICP_CLASSIFY_TGWEB=true
PARSER_TGWEB_PRESCAN_MODE=strict

# Warm path must run before CRM webhook (analysis_status=done)
PARSER_GEMINI_DEFER=true
PARSER_CRM_WEBHOOK_AFTER_ANALYSIS=true
PARSER_WARM_EMBED_PRESCAN=true
PARSER_WARM_EMBED_CLUSTER=true
PARSER_GEMINI_ENGAGE=true
PARSER_ENTITY_OUTREACH_NARRATIVE=true
PARSER_ENTITY_LINK_SUGGEST=true

# Telegram: triage discovered channels; curate manual chats in config/sources.telegram.yaml
PARSER_BG_TELEGRAM=true
PARSER_CHANNEL_TRIAGE=true
TELEGRAM_CHANNELS_PATH=data/runtime/discovered_telegram_channels.json
TELEGRAM_PREFILTER=true
TELEGRAM_GEO_HEURISTIC=true

# Auto-disable source families with raw>=min and zero accepts (needs Mongo source_stats)
PARSER_SOURCE_DISABLE_GOVERNOR=true
PARSER_SOURCE_DISABLE_MIN_RAW=80
PARSER_DISABLED_SOURCES_PATH=data/runtime/disabled_sources.json
# example: config/env/disabled_sources.json.example

# CRM sales inbox: sort/filter by engage_priority (post warm-path analysis)
CRM_ENGAGE_PRIORITY_MIN=70

# Tier 3: source mix routing
PARSER_SOURCE_PRIORITY=true
PARSER_INTENT_CLASSIFY=true
PARSER_LANDER_OUTREACH=false

# Entity sales inbox needs cross-source sightings
PARSER_ENTITY_HEAT_ENABLED=true
PARSER_CRM_WEBHOOK_HEAT_MIN=warm
CRM_ENGAGE_PRIORITY_MIN=70

# Reddit buyer surface
REDDIT_SUBREDDITS=affiliatemarketing,media_buying,adops,PPC,juststart
REDDIT_QUERIES=voluum alternative;tracker too expensive;postback failing;click id not found;self-hosted tracker;tracker migration

# GitHub: do NOT add to PARSER_SOURCE unless pain gate deployed (Tier1). Search queries OK for discovery only.
# GITHUB_SEARCH_QUERIES=voluum alternative;postback failing
