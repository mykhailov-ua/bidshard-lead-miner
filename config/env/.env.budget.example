# Budget profile: VPS + residential proxy <= ~$30/mo total.
#
# Usage:
#   cp .env.example .env
#   cat config/env/.env.budget.example >> .env
#   cat config/env/.env.residential.example >> .env
#   # set GEMINI_API_KEY, TELEGRAM_API_*, PARSER_PROXY_LIST (for cron CF scans only)
#
# Money model (2026-08):
#   VPS NetherlandsVPS NL-4G or Mynymbox NL-4  ~$14-16/mo
#   DataImpulse top-up                          ~$10-12/mo (~10 GB cap)
#   Total                                       ~$24-28/mo
#
# Rule: set PARSER_PROXY_SOURCES so 24/7 parser does not route reddit/discord through residential.
# CF-heavy crawls (forum/tgweb/lander) use proxy; API sources stay direct.
#
# Docs: docs/DEPLOY.md#budget-profile-30-usd

PARSER_SEED_PROFILE=prod
# 24/7 loop: API / light HTTP only (no residential traffic on poll loop).
PARSER_SOURCE=reddit,discord,supply
PARSER_BG_TELEGRAM=1
PARSER_POLL_SEC=300
PARSER_PROXY_SOURCES=forum,tgweb,lander
PARSER_PROXY_DAILY_MB_CAP=350

REDDIT_SUBREDDITS=affiliatemarketing,media_buying,adops,PPC,juststart
REDDIT_MAX_RESULTS=50

MONGO_URI=mongodb://127.0.0.1:27017
PARSER_EXPORT_JSON_HOST=data/export/leads.jsonl

# Gemini defer saves inline RPM; geo after analysis when CRM is on.
PARSER_GEO_CLASSIFY=true
PARSER_GEMINI_DEFER=true
PARSER_ICP_CLASSIFY=true
PARSER_LEAD_STATUS_ENABLED=true
# GEMINI_API_KEY=...

# Residential: store in config/env/.env.proxy.local (NOT in .env).
# Parser 24/7 must not see PARSER_PROXY_LIST or reddit burns proxy GB.
# Example config/env/.env.proxy.local:
#   PARSER_PROXY_LIST=http://user-country-de-session-prod1:PASS@gw.dataimpulse.com:823

PARSER_METRICS_ADDR=:9465
