# Home ISP bridge (merge into VPS .env after tunnel is up)
#
# 1) On home: make home-egress-proxy-up && make home-egress-tunnel
# 2) Paste PARSER_PROXY_LIST from scripts/home-egress/.credentials
# 3) Comment out or remove large PARSER_PROXY_LIST_FILE commercial pools
#
# PARSER_PROXY_LIST=http://parser:YOUR_PASS@127.0.0.1:19888
# PARSER_PROXY_SOURCES=forum,tgweb,lander,webpain,jobboard,serp
# PARSER_HEADLESS_LOCALE=   # auto from proxy user if empty; set to match home country
# PARSER_HEADLESS_TIMEZONE=Europe/Moscow
