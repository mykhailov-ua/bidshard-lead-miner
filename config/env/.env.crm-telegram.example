# CRM Telegram export bot (runs inside crm-bot container alongside HTTP webhook).
#
# 1. Create bot via @BotFather -> copy token
# 2. Message your bot once, then read chat id:
#    curl -s "https://api.telegram.org/bot<TOKEN>/getUpdates" | jq '.result[-1].message.chat.id'
# 3. Append to .env on VPS:
#    cat config/env/.env.crm-telegram.example >> .env
#    docker compose up -d crm-bot
#
# Commands in Telegram:
#   /stats
#   /export
#   /export new
#   /export new 100
#   /jsonl

# Same bot as pain alerts (@LeadProceesorBot) or dedicated export bot.
CRM_TELEGRAM_BOT_TOKEN=
# Supergroup for /export and /stats (add bot as member).
# Group basic id, supergroup ids after migration, personal DM for /export.
CRM_TELEGRAM_ALLOWED_CHAT_IDS=-5167737291,-1004489522664,-1004328627993,6995552007

# Auto-post each CRM webhook lead to Telegram group (Leadgen bot logs).
CRM_TELEGRAM_LEAD_NOTIFY=true
CRM_TELEGRAM_LEAD_NOTIFY_CHAT_IDS=-1004489522664
CRM_TELEGRAM_LEAD_NOTIFY_MIN_SCORE=50

# Optional override; default: PARSER_EXPORT_JSON_HOST or data/export/leads.jsonl
# CRM_TELEGRAM_EXPORT_JSON_PATH=data/export/leads.jsonl

CRM_WEBHOOK_ADDR=:8080
CRM_WEBHOOK_SECRET=
PARSER_CRM_WEBHOOK_URL=http://127.0.0.1:8080/v1/leads
PARSER_CRM_WEBHOOK_SECRET=
PARSER_CRM_WEBHOOK=true
PARSER_CRM_WEBHOOK_AFTER_ANALYSIS=true
