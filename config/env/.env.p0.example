# P0 production profile: keyword-scored leads without Gemini; MTProto-first buyer funnel.
#
# Apply on VPS:
#   bash scripts/ops/vps-apply-p0-env.sh
#   make vps-deploy-p0
#
# Docs: docs/MILESTONE.md (M0, M1)

PARSER_SEED_PROFILE=budget

# Hot poll: no serp (SEO/listicle false positives). SERP only via bgworker registry jobs.
PARSER_SOURCE=webpain,reviews
PARSER_GITHUB_ENABLED=false
PARSER_POLL_SEC=300

# Gemini off: prescan + keyword score + CRM webhook.
GEMINI_API_KEY=
PARSER_GEMINI_DEFER=false
PARSER_ICP_CLASSIFY=false
PARSER_INTENT_CLASSIFY=false
PARSER_GEO_CLASSIFY=false

# CRM -> Telegram lead cards (score floor).
PARSER_CRM_WEBHOOK=true
PARSER_CRM_WEBHOOK_AFTER_ANALYSIS=false
CRM_TELEGRAM_LEAD_NOTIFY=true
CRM_TELEGRAM_LEAD_NOTIFY_MIN_SCORE=50

# Realtime pain alerts (separate container: docker-compose.telegram-realtime.yaml).
TELEGRAM_ALERT_ENABLED=1
# TELEGRAM_ALERT_BOT_TOKEN=...
# TELEGRAM_ALERT_CHANNEL=-100...

# Background: SERP forum/tg discovery, telegram scrape, tgweb registry.
PARSER_BG_WORKER=true
PARSER_BG_TELEGRAM=true
PARSER_BG_SERP_TELEGRAM_MIN=60
