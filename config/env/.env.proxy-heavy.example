# Max parallel crawl profile when residential proxy is cheap/unlimited.
#
# Usage:
#   cp .env.example .env
#   cat config/env/.env.proxy-heavy.example >> .env
#   # PARSER_PROXY_LIST in config/env/.env.proxy.local
#   go run ./cmd/parser config check
#
# Each PARSER_SOURCE entry runs Collect in its own goroutine (PARSER_SOURCE_CONCURRENCY=0).
# tgweb in the poll loop: disable duplicate bg tgweb job via PARSER_BG_TELEGRAM_WEB_MIN=0.

PARSER_SEED_PROFILE=prod

PARSER_SOURCE=forum,webpain,reddit,serp,reviews,supply,lander,tgweb,github
PARSER_GITHUB_ENABLED=true

# One goroutine per source (0 = unlimited errgroup limit).
PARSER_SOURCE_CONCURRENCY=0
PARSER_WORKERS=8
PARSER_HTTP_WORKERS=24
PARSER_TASK_BUFFER=256
PARSER_SCAN_TIMEOUT=15m
PARSER_POLL_SEC=300

# Route CF-heavy HTTP through residential; reddit/github API stay direct.
PARSER_PROXY_SOURCES=forum,tgweb,lander,webpain,serp,reviews,supply
PARSER_PROXY_DAILY_MB_CAP=0

PARSER_BG_WORKER=true
PARSER_BG_TELEGRAM=true
PARSER_BG_TELEGRAM_WEB_MIN=0
PARSER_BG_SERP_TELEGRAM_MIN=45
PARSER_BG_TELEGRAM_DISCOVER_MIN=360
PARSER_BG_TELEGRAM_SCRAPE_MIN=30
PARSER_AUTO_DISCOVER=true
PARSER_CHANNEL_TRIAGE=true

REDDIT_SUBREDDITS=affiliatemarketing,media_buying,adops,PPC,juststart
REDDIT_QUERIES=voluum alternative;tracker too expensive;postback failing;click id not found;self-hosted tracker;tracker migration;media buying team;pay usdt tracker;keitaro too expensive;binom alternative
REDDIT_MAX_RESULTS=50

TELEGRAM_WEB_MAX_DOMAINS=50
FORUM_SEED_PATH=data/seeds/forum_threads.live.csv
SUPPLY_SEED_PATH=data/seeds/domains.prod.csv
LANDER_SEED_PATH=data/seeds/lander_urls.prod.csv
WEB_PAIN_REGISTRY_PATH=data/runtime/discovered_web_pain.json
FORUM_REGISTRY_PATH=data/runtime/discovered_forum_threads.json
TELEGRAM_DOMAINS_PATH=data/runtime/discovered_telegram_domains.json
SOURCE_REGISTRY_PATH=data/runtime/source_registry.json

PARSER_GEMINI_DEFER=true
PARSER_ICP_CLASSIFY=true
