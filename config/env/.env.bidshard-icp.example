# BidShard ICP profile: in-house media buying teams (not CPA networks, not supply/SSP intel).
#
# Usage on VPS:
#   cat config/env/.env.bidshard-icp.example >> .env
#   # proxy: PARSER_PROXY_LIST_FILE=config/env/proxy.list (make vps-sync-proxy)
#   docker compose up -d mongo parser crm-bot
#   docker compose -f docker-compose.telegram-realtime.yaml --profile parser-telegram-realtime up -d
#
# Docs: docs/ICP.md docs/OUTREACH.md

PARSER_SEED_PROFILE=prod

# Pain sources only; supply (ads.txt SSP) deprioritized for BidShard GTM.
PARSER_SOURCE=forum,webpain,reddit,serp,reviews,tgweb,github
PARSER_GITHUB_ENABLED=true
PARSER_SOURCE_CONCURRENCY=0
PARSER_WORKERS=8
PARSER_HTTP_WORKERS=20
PARSER_TASK_BUFFER=256
PARSER_SCAN_TIMEOUT=12m
PARSER_POLL_SEC=300

# Residential proxy on CF sources; reddit/github direct.
PARSER_PROXY_LIST_FILE=config/env/proxy.list
PARSER_PROXY_SOURCES=forum,tgweb,webpain,serp,reviews
PARSER_PROXY_DAILY_MB_CAP=350

# JSONL export for lead-tail / CRM bot.
PARSER_EXPORT_JSON=/app/data/export/leads.jsonl
PARSER_EXPORT_JSON_HOST=data/export/leads.jsonl

# Telegram MTProto: chunked scrape + realtime listener (separate container only).
TELEGRAM_PREFILTER=true
TELEGRAM_GEO_HEURISTIC=true
# TELEGRAM_REALTIME=1  # set only in docker-compose.telegram-realtime.yaml, not main parser
TELEGRAM_REALTIME_BACKFILL=300
TELEGRAM_HISTORY_CHUNK_SIZE=100
TELEGRAM_HISTORY_CHUNK_DELAY_MIN=1.5
TELEGRAM_HISTORY_CHUNK_DELAY_MAX=3.5
TELEGRAM_DISCUSSION_SCRAPE=true
PARSER_BG_WORKER=true
PARSER_BG_TELEGRAM=true
PARSER_CHANNEL_TRIAGE=true
PARSER_BG_SERP_TELEGRAM_MIN=60
PARSER_SERP_TELEGRAM_DORK_MAX=24
PARSER_BG_TELEGRAM_DISCOVER_MIN=360
PARSER_BG_TELEGRAM_SCRAPE_MIN=30
TELEGRAM_CHANNELS_PATH=data/runtime/discovered_telegram_channels.json
# Controlled invite joins for invite-only cross_mention seeds (ICP gate in join_policy.py).
TELEGRAM_INVITE_JOIN=0
TELEGRAM_INVITE_JOIN_LIMIT=2

# Global SearchGlobal micro-dose (OFF by default - high FloodWait risk).
# TELEGRAM_GLOBAL_SEARCH=1
# TELEGRAM_GLOBAL_SEARCH_LIMIT=3
# TELEGRAM_GLOBAL_SEARCH_DAILY_LIMIT=3
# TELEGRAM_GLOBAL_SEARCH_UTC_HOURS=2-6

# Pain alerts to bizdev group @LeadProceesorBot (supergroup id; see .env.telegram-alert.example).
TELEGRAM_ALERT_ENABLED=1
TELEGRAM_ALERT_CHANNEL=-1004489522664

# Warm path + ICP (ban-context phrases get LLM, not hard reject).
# RPM budget: see config/env/.env.gemini-rpm.example (merged below).
PARSER_GEMINI_DEFER=true
PARSER_GEMINI_ENGAGE_MEDIUM=false
PARSER_WARM_EMBED_PRESCAN=false
PARSER_WARM_EMBED_CLUSTER=false
GEMINI_LEAD_ANALYZE_INTERVAL=5m
GEMINI_LEAD_BATCH_SIZE=12
GEMINI_LEAD_ENGAGE_BATCH_SIZE=4
WARM_ANALYSIS_RETRY_MAX=3
WARM_ANALYSIS_DLQ_COLLECTION=warm_analysis_dlq
PARSER_ICP_CLASSIFY=true
PARSER_ICP_CLASSIFY_TGWEB=true
PARSER_INTENT_CLASSIFY=true
PARSER_ENTITY_HEAT_ENABLED=true
CRM_ENGAGE_PRIORITY_MIN=70

# CRM webhook to crm-bot (fill CRM_WEBHOOK_SECRET on VPS).
PARSER_CRM_WEBHOOK=true
PARSER_CRM_WEBHOOK_AFTER_ANALYSIS=true
PARSER_CRM_WEBHOOK_URL=http://127.0.0.1:8080/v1/leads

REDDIT_SUBREDDITS=affiliatemarketing,media_buying,adops,PPC,juststart
REDDIT_QUERIES=voluum alternative;keitaro alternative;postback failing;postback timeout;tracker migration;self-hosted tracker;click id not found;keitaro too expensive;binom stuck;capi error;upstream timed out;502 bad gateway;tracker numbers don't match;parallel pilot
REDDIT_MAX_RESULTS=50

# GitHub issue search (requires GITHUB_TOKEN on VPS).
GITHUB_SEARCH_QUERIES=keitaro postback;voluum alternative;binom postback;orbitra postback;traffoflex;self-hosted tracker migration;click id not found;postback timeout
