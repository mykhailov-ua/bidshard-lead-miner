# M9 soak / ICP report thresholds (merge into .env or export before running scripts).
#
# Usage:
#   set -a && source config/env/.env.soak.example && set +a
#   bash scripts/ops/icp-soak-report.sh --vps
#   SOAK_HOURS=48 M2_STRICT=1 bash scripts/ops/vps-telegram-realtime-soak.sh
#
# Parser Prometheus (VPS profile sets PARSER_METRICS_ADDR=:9465).
PARSER_METRICS_ADDR=:9465
PARSER_METRICS_URL=http://127.0.0.1:9465/metrics

# M9 export gates (icp-soak-report.sh, acceptance-soak.sh).
SOAK_MIN_CONTACT_VALID_PCT=95
SOAK_HOURS=168
ACCEPTANCE_MAX_PENDING_PCT=20
ACCEPTANCE_MIN_INTENT_PCT=25
ACCEPTANCE_MIN_TG_PAIN_PCT=30

# M2 realtime soak (vps-telegram-realtime-soak.sh).
M2_STRICT=0
M2_MIN_ALERTS_PER_DAY=3
