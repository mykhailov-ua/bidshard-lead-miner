# VPS / boxed product profile - merge after .env.example
#
# Usage:
#   cp .env.example .env
#   cat config/env/.env.vps.example >> .env
#   cat config/env/.env.tgweb.example >> .env
#   cat config/env/.env.residential.example >> .env
#   # set GEMINI_API_KEY, TELEGRAM_API_*, PARSER_PROXY_LIST
#   make vps-preflight
#   make deploy-preflight   # vps-preflight + BPF leak gate (Linux + sudo)
#   make tgweb-green-accept
#
# Docs: docs/DEPLOY.md (provider picks), docs/OPS.md#proxy

PARSER_SEED_PROFILE=prod
# See config/env/.env.precision.example for accept-quality Tier 0 (no lander in default mix)
PARSER_SOURCE=forum,supply,reddit,serp,reviews,tgweb
PARSER_BG_TELEGRAM=1
PARSER_POLL_SEC=120

# Global scoring/discovery (see config/env/.env.global.example)
KEYWORDS_LOCALE=es,pt
GEMINI_DISCOVER_DIFF_EVERY=5
GEMINI_DISCOVER_DIFF_DIR=data/suggestions
REDDIT_SUBREDDITS=affiliatemarketing,media_buying,adops,PPC,juststart

SUPPLY_SEED_PATH=data/seeds/domains.prod.csv
LANDER_SEED_PATH=data/seeds/lander_urls.prod.csv
FORUM_SEED_PATH=data/seeds/forum_threads.live.csv
TELEGRAM_DOMAINS_PATH=data/runtime/discovered_telegram_domains.json

# Host paths (override Docker /app/... from base .env)
PARSER_EXPORT_JSON_HOST=data/export/leads.jsonl
MONGO_URI=mongodb://127.0.0.1:27017

# tgweb sync ICP + geo compliance (required before CRM webhook)
PARSER_ICP_CLASSIFY_TGWEB=true
PARSER_ICP_CLASSIFY=true
PARSER_EMBED_PRESCAN=true
PARSER_GEO_CLASSIFY=true
PARSER_GEMINI_SYNC_GEO=true
PARSER_GEMINI_DEFER=true
PARSER_TGWEB_PRESCAN_MODE=strict
PARSER_LEAD_STATUS_ENABLED=true
PARSER_MX_CHECK=true
PARSER_CRM_WEBHOOK_AFTER_ANALYSIS=true
# GEMINI_API_KEY=...

# Residential proxy (required on datacenter VPS for CF forum/tgweb)
# PARSER_PROXY_LIST=http://user-country-us-session-abc:pass@gw.dataimpulse.com:823
PARSER_PROXY_SOURCES=forum,tgweb,lander
PARSER_CHANNEL_TRIAGE=true
PARSER_SOURCE_DISABLE_GOVERNOR=true
PARSER_DOMAIN_TRIAGE=true

# Prometheus metrics (scrape + alert rules in docs/PROMETHEUS/parser-alerts.example.yml)
PARSER_METRICS_ADDR=:9465

# Pre-deploy BPF leak probe (Linux + sudo). Set 0 to skip in make deploy-preflight.
PARSER_BPF_PREFLIGHT=1
# TGWEB_BPF_LEAK_DOMAINS=blask.com
# PARSER_BPF_SUDO_PASS=

# Optional Telethon MTProto proxy (blocked datacenter VPS; not PARSER_PROXY_LIST)
# TELEGRAM_PROXY_URL=socks5://user:pass@host:1080

# Optional CRM webhook (POST LeadDoc JSON on accept)
# PARSER_CRM_WEBHOOK_URL=http://127.0.0.1:8080/v1/leads
# PARSER_CRM_WEBHOOK_SECRET=
# PARSER_CRM_WEBHOOK=true
