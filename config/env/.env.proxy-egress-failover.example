# VPS proxy egress failover (systemd timer). Copy to var/proxy-egress/failover.env on the parser host.
#
# Probes a sample of residential proxies; if non-403 ratio drops below MIN_OK_RATIO, switch to home tunnel.
# When residential recovers, switch back after CONSECUTIVE_GOOD probe rounds.
#
# Prerequisites on VPS:
#   var/home-egress.credentials     (from make vps-apply-home-proxy)
#   var/proxy-egress/residential.snapshot (from make vps-save-residential-proxy or auto on first run)
#   Home PC: Squid + reverse SSH tunnel while mode=home

# Fraction of probe responses that must NOT be HTTP 403 (0.0-1.0). Default 0.55 = at most ~45% 403.
PROXY_FAILOVER_MIN_OK_RATIO=0.55

# Residential URLs to sample per probe round (from list file or snapshot).
PROXY_FAILOVER_SAMPLE_PROXIES=6

# Space-separated probe targets (CF-sensitive + baseline).
PROXY_FAILOVER_PROBE_URLS="https://example.com/ https://blask.com/about"

# Hysteresis: avoid flapping when pool is borderline.
PROXY_FAILOVER_CONSECUTIVE_BAD=2
PROXY_FAILOVER_CONSECUTIVE_GOOD=3

# Optional: force residential probe list when parser already uses home (default: residential.snapshot).
# PROXY_FAILOVER_RESIDENTIAL_LIST_FILE=config/env/proxy.list

# Home tunnel URL marker (do not change unless you change tunnel port).
PROXY_FAILOVER_HOME_MARK=127.0.0.1:19888

# Set 1 to log actions only (no .env / parser restart).
# PROXY_FAILOVER_DRY_RUN=0
