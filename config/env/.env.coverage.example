# Lead-gen max coverage profile (Epic H) - merge after .env.example
#
# Usage:
#   cp .env.example .env
#   cat config/env/.env.coverage.example >> .env
#   # set GEMINI_API_KEY, TELEGRAM_API_*, PARSER_PROXY_LIST (forum/lander CF)
#   go run ./cmd/parser config check
#
# HTTP crawl mix: forum + webpain + reddit + serp + supply + lander.
# webpain is opt-in (not in PARSER_SOURCE=all). SERP fills discovery registries via bg workers.
# Add tgweb via config/env/.env.tgweb.example for Telegram-site LPR crawl.

PARSER_SEED_PROFILE=prod
PARSER_SOURCE=forum,webpain,reddit,serp,supply,lander
PARSER_BG_TELEGRAM=true
PARSER_POLL_SEC=180

# Discovery registries + domain cascade fan-out
PARSER_AUTO_DISCOVER=true
PARSER_SEED_FEEDBACK=true
PARSER_SEED_FEEDBACK_MIN_HEAT=warm
PARSER_BG_FORUM_DISCOVER_INTERVAL=12h
PARSER_BG_SOURCE_REGISTRY_SYNC_MIN=30

# Epic H: profile pages + email-parity engage/outreach
PARSER_PROFILE_ENRICH=true
PARSER_GEMINI_ENGAGE=true
PARSER_GEMINI_ENRICH_SYNTH=true

# Global keyword overlays (LATAM/EU bias)
KEYWORDS_LOCALE=es,pt
GEMINI_DISCOVER_DIFF_EVERY=5
GEMINI_DISCOVER_DIFF_DIR=data/suggestions

REDDIT_SUBREDDITS=affiliatemarketing,media_buying,adops,PPC,juststart
REDDIT_QUERIES=voluum alternative;tracker too expensive;postback failing;click id not found;self-hosted tracker;tracker migration
REDDIT_MAX_RESULTS=50

# Enrichment + email quality (H-11: enable MX on VPS with stable egress)
PARSER_ENRICH_RDAP=true
PARSER_ENRICH_DNS=true
PARSER_ENRICH_EMAIL=true
PARSER_MX_CHECK=true
# PARSER_ENRICH_SMTP_VERIFY=true  # optional; slow; residential egress may block SMTP

# Gemini warm path (defer saves inline RPM on poll loop)
GEMINI_API_KEY=
PARSER_GEO_CLASSIFY=true
PARSER_GEMINI_DEFER=true
PARSER_ICP_CLASSIFY=true
PARSER_LEAD_STATUS_ENABLED=true

# CF-heavy crawlers via proxy; reddit/serp API stay direct
PARSER_PROXY_SOURCES=forum,tgweb,lander,serp
PARSER_PROXY_DAILY_MB_CAP=500

SUPPLY_SEED_PATH=data/seeds/domains.prod.csv
LANDER_SEED_PATH=data/seeds/lander_urls.prod.csv
FORUM_SEED_PATH=data/seeds/forum_threads.live.csv
WEB_PAIN_REGISTRY_PATH=data/runtime/discovered_web_pain.json
FORUM_REGISTRY_PATH=data/runtime/discovered_forum_threads.json
SOURCE_REGISTRY_PATH=data/runtime/source_registry.json
TELEGRAM_DOMAINS_PATH=data/runtime/discovered_telegram_domains.json

MONGO_URI=mongodb://127.0.0.1:27017
PARSER_EXPORT_JSON_HOST=data/export/leads.jsonl
PARSER_METRICS_ADDR=:9465
