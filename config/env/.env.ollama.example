# Local LLM via Ollama (Gemma 3). No Gemini API key; no cloud RPM limits.
#
# Prerequisites on VPS:
#   curl -fsSL https://ollama.com/install.sh | sh
#   ollama pull gemma3:12b
#   ollama pull nomic-embed-text
#
# Usage:
#   cat config/env/.env.ollama.example >> .env
#
# RAM: gemma3:12b Q4 needs ~8-10 GB. CPU-only works but slow (use GEMINI_LEAD_BATCH_SIZE=6).

LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:12b
OLLAMA_EMBED_MODEL=nomic-embed-text

PARSER_GEMINI_DEFER=true
PARSER_ICP_CLASSIFY=true
PARSER_GEO_CLASSIFY=true
GEMINI_MAX_OUTPUT_TOKENS=4096
GEMINI_LEAD_BATCH_SIZE=8
GEMINI_LEAD_ENGAGE_BATCH_SIZE=3
GEMINI_LEAD_ANALYZE_INTERVAL=3m
