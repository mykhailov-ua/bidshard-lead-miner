# Residential proxy credentials for CF crawls only.
# Copy to config/env/.env.proxy.local (gitignored via config/env/.gitignore if present).
#
#   cp config/env/.env.residential.example config/env/.env.proxy.local
#   # edit PARSER_PROXY_LIST
#
# Used by: scripts/ops/cf-crawl-cron.sh
# Do NOT merge into root .env (keeps 24/7 parser off residential).

# Option A: file with one proxy per line (user:pass@host:port)
#   cp ../../proxy.txt config/env/proxy.list
#   bash scripts/ops/sync-proxy-to-vps.sh
PARSER_PROXY_LIST_FILE=config/env/proxy.list

# Option B: inline comma-separated URLs
# PARSER_PROXY_LIST=http://user-country-de-session-prod1:PASS@gw.dataimpulse.com:823
