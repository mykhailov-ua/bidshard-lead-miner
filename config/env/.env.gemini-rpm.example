# Gemini RPM budget profile - minimize API requests per minute (not token spend).
#
# Usage:
#   cat config/env/.env.gemini-rpm.example >> .env
#
# Strategy:
#   - PARSER_GEMINI_DEFER=true: one core batch per tick (ICP/geo/pilot), no hot-path ICP/intent
#   - Engage/outreach: second pass, High priority only, small chunks
#   - Disable embed prescan on warm path unless needed (each embed = API call)
#
# Free tier gemini-3.6-flash: ~15 RPM. Target <= 12 RPM steady.

GEMINI_RPM=12
GEMINI_JUNK_ANALYZE=false
GEMINI_BATCH_SIZE=5
GEMINI_ANALYZE_INTERVAL=4h
WARM_ANALYSIS_PENDING_SCAN_INTERVAL=2m
WARM_ANALYSIS_PENDING_STALE=5m
PARSER_ENTITY_GEMINI_ENABLED=false

PARSER_GEMINI_DEFER=true
PARSER_ICP_CLASSIFY=true
PARSER_GEO_CLASSIFY=true
PARSER_GEMINI_SYNC_GEO=true
PARSER_INTENT_CLASSIFY=false

GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_LEAD_ANALYZE_INTERVAL=5m
GEMINI_LEAD_BATCH_SIZE=12
GEMINI_LEAD_ENGAGE_BATCH_SIZE=4

PARSER_GEMINI_ENGAGE=true
PARSER_GEMINI_ENRICH_SYNTH=true
PARSER_GEMINI_ENGAGE_MEDIUM=false
PARSER_WARM_EMBED_PRESCAN=false
PARSER_WARM_EMBED_CLUSTER=false
PARSER_EMBED_PRESCAN=false
