# Discord bot pool (copy to .env.discord.local, gitignored).
# Token files: discord_token_0.txt, discord_token_1.txt in repo root (see discord.tokens.pool.json).
#
# Enable Message Content Intent on each bot (Developer Portal).
# DISCORD_BOT_TOKENS is comma-separated; DISCORD_BOT_TOKEN is legacy single-bot alias.
#
# DISCORD_BOT_TOKENS=
# DISCORD_CHANNEL_IDS=123456789012345678,987654321098765432
# DISCORD_MAX_MESSAGES=50
